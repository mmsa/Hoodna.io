{
  "expo": {
    "name": "eljiran",
    "slug": "eljiran-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#F9F8F1",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eljiran.mobile",
      "buildNumber": "19",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "eljiran needs photo access so you can upload verification documents and listing images.",
        "NSCameraUsageDescription": "eljiran needs camera access so you can take photos for verification and listings.",
        "NSDocumentPickerUsageDescription": "eljiran needs document access so you can upload verification files."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F9F8F1"
      },
      "package": "com.eljiran.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eljiran.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "eljiran needs photo access so you can upload verification documents and listing images.",
          "cameraPermission": "eljiran needs camera access so you can take photos for verification and listings."
        }
      ]
    ],
    "scheme": "eljiran",
    "extra": {
      "apiUrl": "https://eljiran-api.onrender.com",
      "eas": {
        "projectId": "63b7e09f-03e0-46e9-a783-9a659a5d5c83"
      },
      "router": {}
    },
    "owner": "mmsa"
  }
}
