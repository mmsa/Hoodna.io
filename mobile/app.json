{
  "expo": {
    "name": "eljiran",
    "slug": "eljiran-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2D6A4F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eljiran.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D6A4F"
      },
      "package": "com.eljiran.mobile"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "eljiran",
    "extra": {
      "apiUrl": "http://192.168.1.8:8000"
    }
  }
}

