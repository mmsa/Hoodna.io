# Copy to .env — Expo reads EXPO_PUBLIC_API_URL at Metro start.
# Restart with: npx expo start -c
#
# Deployed API (default for local testing against production):
EXPO_PUBLIC_API_URL=https://eljiran-api.onrender.com
