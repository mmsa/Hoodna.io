# Phone verification (Akedly). Server-side only — never ship these to the web or mobile app.
# Pipeline must be API version V1.2. Leave Turnstile off; the API solves proof-of-work itself.
AKEDLY_API_KEY=
AKEDLY_PIPELINE_ID=
# AKEDLY_API_BASE=https://api.akedly.io/api/v1.2

# Optional send throttles
# OTP_MAX_PER_PHONE_PER_HOUR=5
# OTP_MAX_PER_IP_PER_HOUR=20
# OTP_RESEND_COOLDOWN_SECONDS=60
